# Copy to .env and fill in. .env is gitignored.

PORT=4000
# the frontend's address, for CORS and for links in password-reset messages
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# MySQL (the server you manage in MySQL Workbench). The database and tables are
# created on first start if they don't exist.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_learning
# add the demo school (password Demo@1234 for every account, an administrator included)
# when the database is empty. On by default in development, off with NODE_ENV=production,
# where setting it to true stops the server from starting.
# SEED_DEMO_DATA=true

# sign-in tokens; set a long random value, e.g. from: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Nobody signs up. Create the first administrator with
#   npm run create-admin -- --name "Jane Doe" --email jane@school.org
# and they add every learner and staff member from the admin dashboard.

# AI features (Claude). Without a key they answer 503 ai_unavailable and the app carries on without AI.
ANTHROPIC_API_KEY=
AI_ENABLED=true
CLAUDE_MODEL=claude-opus-5-5

# Email (password-reset links). Any SMTP server works. Without SMTP_HOST, emails are
# written to the server log instead of sent.
#   Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=you@gmail.com
#            SMTP_PASS=a 16-character App Password (Google Account > Security > App passwords;
#            needs 2-Step Verification). Your normal Gmail password will not work.
#   Outlook / Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# who the email is from, e.g. Smart Learning <you@gmail.com> (defaults to SMTP_USER)
MAIL_FROM=

UPLOAD_DIR=uploads

# The support chat runs in the Python chatbot (smart_learning/chatbot), which reads this file too.
# Set CHATBOT_SECRET to a long random value, e.g. from:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHATBOT_URL=http://127.0.0.1:8000
CHATBOT_SECRET=
